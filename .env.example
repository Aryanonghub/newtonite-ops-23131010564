# Copy to .env and change values. .env is git-ignored.

# Used by docker compose (falls back to a dev-only default if unset).
JWT_SECRET=change-me-to-a-long-random-string

# Used when running the server or tests directly on your machine (outside Docker).
DATABASE_URL=postgres://ops:ops@localhost:5432/ops
TEST_DATABASE_URL=postgres://ops:ops@localhost:5432/ops_test
